        "major"
      ],
      "matchManagers": [
        "composer"
      ],
      "matchPackageNames": [
        "/^php$/",
        "!/^wpackagist/",
        "!/^wp-plugin/",
        "!/^wp-theme/",
        "!/^linchpin/"
      ],
      "labels": [
        "composer",
        "maintenance",
        "build"
